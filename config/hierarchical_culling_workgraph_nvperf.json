{
  "name": "BasicRenderer work-graph CLOD hardware metrics",
  "readiness": {
    "stable_frames": 120,
    "settling_frames": 30,
    "timeout_ms": 300000
  },
  "statistics": {
    "minimum_samples": 3,
    "maximum_samples": 5,
    "confidence_level": 0.95,
    "relative_half_width": 1.0
  },
  "output": {
    "database": "out/hierarchical_culling_workgraph_nvperf.sqlite",
    "last_run_summary": "out/hierarchical_culling_workgraph_nvperf.md"
  },
  "metrics": [
    {
      "id": "gpu_time",
      "name": "gpu__time_duration",
      "output_name": "GPU duration",
      "unit": "ns",
      "type": "counter",
      "rollup": "sum",
      "submetric": "none"
    },
    {
      "id": "sm_throughput",
      "name": "sm__throughput",
      "output_name": "SM throughput",
      "unit": "%",
      "type": "throughput",
      "rollup": "avg",
      "submetric": "pct_of_peak_sustained_elapsed"
    },
    {
      "id": "l2_throughput",
      "name": "lts__throughput",
      "output_name": "L2 throughput",
      "unit": "%",
      "type": "throughput",
      "rollup": "avg",
      "submetric": "pct_of_peak_sustained_elapsed"
    },
    {
      "id": "dram_throughput",
      "name": "dram__throughput",
      "output_name": "DRAM throughput",
      "unit": "%",
      "type": "throughput",
      "rollup": "avg",
      "submetric": "pct_of_peak_sustained_elapsed"
    },
    {
      "id": "warps_active",
      "name": "smsp__warps_active",
      "output_name": "Active warps/cycle",
      "unit": "warps/cycle",
      "type": "counter",
      "rollup": "avg",
      "submetric": "per_cycle_active",
      "required": false
    },
    { "id": "smsp_throughput", "name": "smsp__throughput", "output_name": "SMSP throughput", "unit": "%", "type": "throughput", "rollup": "avg", "submetric": "pct_of_peak_sustained_elapsed", "required": false },
    { "id": "instructions", "name": "smsp__inst_executed", "output_name": "Instructions executed", "unit": "instructions", "type": "counter", "rollup": "sum", "submetric": "none" },
    { "id": "warps_eligible", "name": "smsp__warps_eligible", "output_name": "Eligible warps", "unit": "warps/cycle", "type": "ratio", "rollup": "avg", "submetric": "ratio", "required": false },
    { "id": "stall_barrier", "name": "smsp__warp_issue_stalled_barrier_per_warp_active", "output_name": "Stall: barrier", "unit": "cycles/warp", "type": "ratio", "rollup": "avg", "submetric": "ratio" },
    { "id": "stall_branch", "name": "smsp__warp_issue_stalled_branch_resolving_per_warp_active", "output_name": "Stall: branch resolving", "unit": "cycles/warp", "type": "ratio", "rollup": "avg", "submetric": "ratio" },
    { "id": "stall_dispatch", "name": "smsp__warp_issue_stalled_dispatch_stall_per_warp_active", "output_name": "Stall: dispatch", "unit": "cycles/warp", "type": "ratio", "rollup": "avg", "submetric": "ratio" },
    { "id": "stall_imc_miss", "name": "smsp__warp_issue_stalled_imc_miss_per_warp_active", "output_name": "Stall: IMC miss", "unit": "cycles/warp", "type": "ratio", "rollup": "avg", "submetric": "ratio", "required": false },
    { "id": "stall_lg_throttle", "name": "smsp__warp_issue_stalled_lg_throttle_per_warp_active", "output_name": "Stall: LG throttle", "unit": "cycles/warp", "type": "ratio", "rollup": "avg", "submetric": "ratio" },
    { "id": "stall_long_scoreboard", "name": "smsp__warp_issue_stalled_long_scoreboard_per_warp_active", "output_name": "Stall: long scoreboard", "unit": "cycles/warp", "type": "ratio", "rollup": "avg", "submetric": "ratio" },
    { "id": "stall_math_throttle", "name": "smsp__warp_issue_stalled_math_pipe_throttle_per_warp_active", "output_name": "Stall: math-pipe throttle", "unit": "cycles/warp", "type": "ratio", "rollup": "avg", "submetric": "ratio" },
    { "id": "stall_membar", "name": "smsp__warp_issue_stalled_membar_per_warp_active", "output_name": "Stall: memory barrier", "unit": "cycles/warp", "type": "ratio", "rollup": "avg", "submetric": "ratio" },
    { "id": "stall_mio_throttle", "name": "smsp__warp_issue_stalled_mio_throttle_per_warp_active", "output_name": "Stall: MIO throttle", "unit": "cycles/warp", "type": "ratio", "rollup": "avg", "submetric": "ratio" },
    { "id": "stall_no_instruction", "name": "smsp__warp_issue_stalled_no_instruction_per_warp_active", "output_name": "Stall: no instruction", "unit": "cycles/warp", "type": "ratio", "rollup": "avg", "submetric": "ratio" },
    { "id": "stall_not_selected", "name": "smsp__warp_issue_stalled_not_selected_per_warp_active", "output_name": "Stall: not selected", "unit": "cycles/warp", "type": "ratio", "rollup": "avg", "submetric": "ratio" },
    { "id": "stall_short_scoreboard", "name": "smsp__warp_issue_stalled_short_scoreboard_per_warp_active", "output_name": "Stall: short scoreboard", "unit": "cycles/warp", "type": "ratio", "rollup": "avg", "submetric": "ratio" },
    { "id": "stall_tex_throttle", "name": "smsp__warp_issue_stalled_tex_throttle_per_warp_active", "output_name": "Stall: texture throttle", "unit": "cycles/warp", "type": "ratio", "rollup": "avg", "submetric": "ratio" },
    { "id": "stall_wait", "name": "smsp__warp_issue_stalled_wait_per_warp_active", "output_name": "Stall: wait", "unit": "cycles/warp", "type": "ratio", "rollup": "avg", "submetric": "ratio" },
    { "id": "l1_throughput", "name": "l1tex__throughput", "output_name": "L1/TEX throughput", "unit": "%", "type": "throughput", "rollup": "avg", "submetric": "pct_of_peak_sustained_elapsed" }
  ],
  "passes": [
    {
      "id": "hierarchical_culling_pass1",
      "name": "CLodOpaque::HierarchicalCullingPass1",
      "queue": "Compute",
      "occurrence": 0,
      "metrics": [
        "gpu_time",
        "sm_throughput",
        "l2_throughput",
        "dram_throughput",
        "warps_active", "smsp_throughput", "instructions", "warps_eligible",
        "stall_barrier", "stall_branch", "stall_dispatch", "stall_imc_miss",
        "stall_lg_throttle", "stall_long_scoreboard", "stall_math_throttle",
        "stall_membar", "stall_mio_throttle", "stall_no_instruction",
        "stall_not_selected", "stall_short_scoreboard", "stall_tex_throttle",
        "stall_wait", "l1_throughput"
      ]
    },
    {
      "id": "hierarchical_culling_pass2",
      "name": "CLodOpaque::HierarchicalCullingPass2",
      "queue": "Compute",
      "occurrence": 0,
      "metrics": [
        "gpu_time",
        "sm_throughput",
        "l2_throughput",
        "dram_throughput",
        "warps_active", "smsp_throughput", "instructions", "warps_eligible",
        "stall_barrier", "stall_branch", "stall_dispatch", "stall_imc_miss",
        "stall_lg_throttle", "stall_long_scoreboard", "stall_math_throttle",
        "stall_membar", "stall_mio_throttle", "stall_no_instruction",
        "stall_not_selected", "stall_short_scoreboard", "stall_tex_throttle",
        "stall_wait", "l1_throughput"
      ]
    }
  ]
}
