{
  "name": "Stochastic sample pass hardware metrics",
  "readiness": {
    "stable_frames": 60,
    "settling_frames": 30,
    "timeout_ms": 120000
  },
  "statistics": {
    "minimum_samples": 2,
    "maximum_samples": 2,
    "confidence_level": 0.95,
    "relative_half_width": 1.0
  },
  "output": {
    "database": "out/stochastic_sample_nvperf.sqlite",
    "last_run_summary": "out/stochastic_sample_nvperf.md"
  },
  "metrics": [
    {
      "id": "gpu_time",
      "name": "gpu__time_duration",
      "output_name": "GPU duration",
      "unit": "ns",
      "type": "counter",
      "rollup": "sum",
      "submetric": "none"
    },
    {
      "id": "instructions",
      "name": "smsp__inst_executed",
      "output_name": "Instructions",
      "unit": "instructions",
      "type": "counter",
      "rollup": "sum",
      "submetric": "none"
    },
    {
      "id": "warps_active",
      "name": "smsp__warps_active",
      "output_name": "Active warps",
      "unit": "warps/cycle",
      "type": "ratio",
      "rollup": "avg",
      "submetric": "ratio",
      "required": false
    },
    {
      "id": "sm",
      "name": "sm__throughput",
      "output_name": "SM throughput",
      "unit": "%",
      "type": "throughput",
      "rollup": "avg",
      "submetric": "pct_of_peak_sustained_elapsed"
    },
    {
      "id": "l1",
      "name": "l1tex__throughput",
      "output_name": "L1/TEX throughput",
      "unit": "%",
      "type": "throughput",
      "rollup": "avg",
      "submetric": "pct_of_peak_sustained_elapsed"
    },
    {
      "id": "l2",
      "name": "lts__throughput",
      "output_name": "L2 throughput",
      "unit": "%",
      "type": "throughput",
      "rollup": "avg",
      "submetric": "pct_of_peak_sustained_elapsed"
    },
    {
      "id": "stall_barrier",
      "name": "smsp__warp_issue_stalled_barrier_per_warp_active",
      "output_name": "Stall barrier",
      "unit": "cycles/warp",
      "type": "ratio",
      "rollup": "avg",
      "submetric": "ratio"
    },
    {
      "id": "stall_long",
      "name": "smsp__warp_issue_stalled_long_scoreboard_per_warp_active",
      "output_name": "Stall long scoreboard",
      "unit": "cycles/warp",
      "type": "ratio",
      "rollup": "avg",
      "submetric": "ratio"
    },
    {
      "id": "stall_mio",
      "name": "smsp__warp_issue_stalled_mio_throttle_per_warp_active",
      "output_name": "Stall MIO throttle",
      "unit": "cycles/warp",
      "type": "ratio",
      "rollup": "avg",
      "submetric": "ratio"
    },
    {
      "id": "stall_short",
      "name": "smsp__warp_issue_stalled_short_scoreboard_per_warp_active",
      "output_name": "Stall short scoreboard",
      "unit": "cycles/warp",
      "type": "ratio",
      "rollup": "avg",
      "submetric": "ratio"
    },
    {
      "id": "stall_wait",
      "name": "smsp__warp_issue_stalled_wait_per_warp_active",
      "output_name": "Stall wait",
      "unit": "cycles/warp",
      "type": "ratio",
      "rollup": "avg",
      "submetric": "ratio"
    },
    {
      "id": "launch_register",
      "name": "tpc__warp_launch_cycles_stalled_shader_cs_reason_register_allocation",
      "output_name": "Launch register allocation",
      "unit": "%",
      "type": "counter",
      "rollup": "sum",
      "submetric": "pct_of_peak_sustained_elapsed",
      "required": false
    },
    {
      "id": "launch_shmem",
      "name": "tpc__warp_launch_cycles_stalled_shader_cs_reason_shmem_allocation",
      "output_name": "Launch shared-memory allocation",
      "unit": "%",
      "type": "counter",
      "rollup": "sum",
      "submetric": "pct_of_peak_sustained_elapsed",
      "required": false
    },
    {
      "id": "registers",
      "name": "tpc__average_registers_per_thread_shader_cs",
      "output_name": "Registers/thread",
      "unit": "registers",
      "type": "ratio",
      "rollup": "avg",
      "submetric": "ratio",
      "required": false
    },
    {
      "id": "issue_active",
      "name": "smsp__issue_active",
      "output_name": "Issue active",
      "unit": "%",
      "type": "throughput",
      "rollup": "avg",
      "submetric": "pct_of_peak_sustained_elapsed",
      "required": false
    },
    {
      "id": "l1_hit",
      "name": "l1tex__t_sector_hit_rate",
      "output_name": "L1 hit rate",
      "unit": "%",
      "type": "ratio",
      "rollup": "avg",
      "submetric": "pct",
      "required": false
    }
  ],
  "passes": [
    {
      "id": "select",
      "name": "StochasticSelectPass",
      "queue": "Compute",
      "occurrence": 0,
      "metrics": [
        "gpu_time",
        "instructions",
        "warps_active",
        "sm",
        "l1",
        "l2",
        "stall_barrier",
        "stall_long",
        "stall_mio",
        "stall_short",
        "stall_wait",
        "launch_register",
        "launch_shmem",
        "registers",
        "issue_active",
        "l1_hit"
      ]
    },
    {
      "id": "trace",
      "name": "StochasticTracePass",
      "queue": "Compute",
      "occurrence": 0,
      "metrics": [
        "gpu_time",
        "instructions",
        "warps_active",
        "sm",
        "l1",
        "l2",
        "stall_barrier",
        "stall_long",
        "stall_mio",
        "stall_short",
        "stall_wait",
        "launch_register",
        "launch_shmem",
        "registers",
        "issue_active",
        "l1_hit"
      ]
    },
    {
      "id": "shade",
      "name": "StochasticShadePass",
      "queue": "Compute",
      "occurrence": 0,
      "metrics": [
        "gpu_time",
        "instructions",
        "warps_active",
        "sm",
        "l1",
        "l2",
        "stall_barrier",
        "stall_long",
        "stall_mio",
        "stall_short",
        "stall_wait",
        "launch_register",
        "launch_shmem",
        "registers",
        "issue_active",
        "l1_hit"
      ]
    }
  ]
}