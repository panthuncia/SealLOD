<Project Sdk="Microsoft.NET.Sdk">
  <!-- CPU-only tests of the managed runtime: scheduler ordering, the scenario lifecycle and the compiler, run without a
       native host. Registered with ctest as `dotnet ScriptRuntimeTests.dll <fixtures dir> <scenarios dir>`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Managed\BasicRenderer.Scripting\BasicRenderer.Scripting.csproj" />
  </ItemGroup>
</Project>
